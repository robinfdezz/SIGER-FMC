# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siger_fmc_db
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/siger_fmc_db

# Seguridad y Autenticación JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Configuración CORS (URL del Frontend)
CLIENT_URL=http://localhost:5173

# Configuración de Cloudinary (Subida de Imágenes / Avatares)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo transaccional (Resend) — opcional para alertas por email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# En development, redirige todos los correos a tu buzón de prueba Resend:
RESEND_TEST_TO=

# Protección Anti-Bot Cloudflare Turnstile (Feature Flag: false en desarrollo)
ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
